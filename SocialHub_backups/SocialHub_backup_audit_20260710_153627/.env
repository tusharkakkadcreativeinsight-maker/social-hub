# SocialHub Windows local setup (.env)
# SQLite local fallback (no PostgreSQL required for development)

# Use SQLite for local development
DATABASE_URL=sqlite:///./socialhub.db
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./socialhub.db

# JWT Configuration
SECRET_KEY=change-to-long-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@socialhub.com

# Application Settings
APP_NAME=SocialHub
DEBUG=true
AUTO_CREATE_TABLES=true
SEED_DEMO_ACCOUNTS=false
CORS_ORIGINS=*
APP_URL=http://127.0.0.1:8000

# Uploads
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp4,webm,mov

# Redis Configuration
REDIS_URL=

# Story Auto-Delete Hours
STORY_DURATION_HOURS=24

# Official Meta / Instagram Graph API OAuth (optional; never hardcode secrets)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback
INSTAGRAM_GRAPH_VERSION=v19.0

# Optional AI caption helper. Leave empty to use local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini