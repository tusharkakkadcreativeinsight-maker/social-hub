# Database Configuration
# Default SQLite is normalized by the app to one file: SocialHub/socialhub.db
DATABASE_URL=sqlite:///./socialhub.db
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./socialhub.db
# For PostgreSQL, install/start PostgreSQL, create a database, then use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/socialhub
# DATABASE_URL_ASYNC is optional; the app auto-converts DATABASE_URL to asyncpg.
# DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/socialhub

# JWT Configuration
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
APP_NAME=SocialHub
DEBUG=true
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SEED_DEMO_ACCOUNTS=false
AUTO_CREATE_TABLES=true
MAX_UPLOAD_SIZE=10
STORY_DURATION_HOURS=24
APP_URL=http://localhost:8000

# Email Configuration (leave empty to disable email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tusharkakkad.creativeinsight@gmail.com
SMTP_PASSWORD=ewvlpblmfokzvxf
EMAIL_FROM=noreply@socialhub.com

# Redis (optional, for production)
REDIS_URL=

# Feature toggles
TWO_FACTOR_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=false

# AI Chat (optional)
# OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Official Instagram Graph API / Meta OAuth
# Create a Meta app, add Instagram Graph API permissions, and set this redirect URI in Meta dashboard.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback
INSTAGRAM_GRAPH_VERSION=v19.0
APP_SECRET_KEY=change-this-long-random-token-encryption-key