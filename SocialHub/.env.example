# =============================================================================
# SocialHub Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit real credentials to version control.

# Database
# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/socialhub
# DATABASE_URL_ASYNC=postgresql+asyncpg://user:password@localhost:5432/socialhub
# SQLite (local development only)
DATABASE_URL=sqlite:///./socialhub.db
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./socialhub.db

# JWT Configuration (REQUIRED: change to a strong random key for production)
SECRET_KEY=change-this-to-a-random-64-char-string

# SMTP / Email Configuration
# Gmail example using App Password (not your regular Gmail password):
# https://support.google.com/accounts/answer/185833
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-16-char-gmail-app-password
# EMAIL_FROM=your-email@gmail.com
# EMAIL_FROM_NAME=SocialHub Security
# EMAIL_USE_STARTTLS=true
# EMAIL_USE_SSL=false
# APP_URL=http://localhost:8000

# Application
APP_NAME=SocialHub
DEBUG=true
AUTO_CREATE_TABLES=true
CORS_ORIGINS=*

# Uploads
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp4,webm,mov

# Email verification
EMAIL_VERIFICATION_REQUIRED=true